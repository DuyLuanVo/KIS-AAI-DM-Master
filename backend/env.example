# Sao chép thành backend/.env rồi sửa nếu cần. Mọi dòng đều tùy chọn.

# --- Qdrant ---
# server: dùng Qdrant chạy bằng docker-compose (mặc định)
# local : lưu vào thư mục qdrant_local/, không cần Docker (chỉ 1 tiến trình được mở cùng lúc)
QDRANT_MODE=server
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=kis_architecture

# --- Lưu ảnh ---
# minio: ảnh dataset và ảnh tải lên được đưa lên MinIO (mặc định)
# local: đọc ảnh dataset trực tiếp từ data/vietnam_architecture, ảnh tải lên lưu ở media/
STORAGE_BACKEND=minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=kis-keyframes

# --- Mô hình ---
# clip: CLIP cho ảnh + sentence-transformers cho caption (mặc định)
# lite: không cần model, chỉ để thử giao diện / chạy test
EMBEDDER_BACKEND=clip
CLIP_MODEL=ViT-B/32
# CLIP đã fine-tune bằng scripts/finetune_clip.py (để trống = CLIP gốc).
# Đổi dòng này thì chạy lại: python scripts/reembed_images.py
CLIP_FINETUNED_PATH=models/clip_finetuned/clip_vitb32_kis.pt
# Thêm nhánh CLIP text -> image khi tìm bằng mô tả
CLIP_TEXT_SEARCH=true
TEXT_MODEL=sentence-transformers/all-mpnet-base-v2
# Muốn gõ truy vấn tiếng Việt thì dùng model đa ngôn ngữ (phải chạy lại index_dataset.py --recreate):
# TEXT_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
